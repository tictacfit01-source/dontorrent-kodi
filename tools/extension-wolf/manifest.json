{
  "manifest_version": 3,
  "name": "MejorWolf · WolfTorrent → tele",
  "version": "1.1.0",
  "description": "Cuando tu navegador termina de bajar un .torrent o el ZIP del día de WolfTorrent, se lo da a MejorWolf. No toca su verificación.",
  "permissions": ["downloads", "notifications", "alarms", "storage"],
  "host_permissions": [
    "https://wolftorrent.com/*",
    "https://mw-render-relay-6noq.onrender.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "MejorWolf" },
  "options_page": "opciones.html",
  "icons": { "48": "icono.png", "128": "icono.png" }
}
